[Unit]
# 例行回收：清掉超過 KEEP_HOURS 的 Docker build cache
# 近期的快取刻意保留，讓連續幾次 docker compose build 還有快取可用
Documentation=https://github.com/Yanagi-0912/CARE-infra
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/care/disk-guard.env
ExecStart=/usr/local/sbin/vm-disk-guard.sh prune

Nice=10
IOSchedulingClass=idle
